# Installation identity is immutable for a database. Never copy lab defaults.
TENANT_ID=my-installation
AUTOMATION_IMAGE=automation-api:1.0.0
AUTOMATION_SECRETS_DIR=./secrets
ADMIN_PORT=8088
WEBHOOK_PORT=8089
# Deny by default. Populate explicitly after verifying credentials and scope.
ALLOWED_REPOSITORIES=
ALLOWED_JIRA_PROJECTS=
JIRA_REQUIRED_LABEL=automation-managed
# Dedicated service account IDs whose webhooks must never trigger rules.
JIRA_IGNORED_ACTOR_IDS=
BITBUCKET_ACCOUNT_EMAIL=
JIRA_ACCOUNT_EMAIL=
JIRA_CLOUD_ID=
JIRA_MAX_DAILY_WRITES=100
BITBUCKET_MAX_DAILY_WRITES=100
