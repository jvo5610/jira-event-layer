# Installation identity is immutable for a database. Never copy lab defaults.
TENANT_ID=my-installation
AUTOMATION_IMAGE=automation-api:1.0.0
STUDIO_IMAGE=jira-relay-studio:1.0.0
AUTOMATION_SECRETS_DIR=./secrets
ADMIN_PORT=8088
WEBHOOK_PORT=8089
# Database endpoint shared by runtime and migration job. Passwords are mounted secrets.
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=jira_relay
DB_USER=jira_relay_runtime
# Compose-only: injected as DB_USER exclusively into the migrate service.
DB_MIGRATION_USER=jira_relay_migrator
# Optional engine limits.
MAX_BODY_BYTES=10485760
AUTH_ROTATION_TTL_SECONDS=3600
# Deny by default. Populate explicitly after verifying credentials and scope.
ALLOWED_REPOSITORIES=
BITBUCKET_ACCOUNT_EMAIL=
JIRA_CLOUD_ID=
JIRA_MAX_DAILY_WRITES=100
BITBUCKET_MAX_DAILY_WRITES=100

# Optional GUI (docker compose --profile studio). Secrets use the same directory.
STUDIO_BACKEND_URL=http://api:8080
STUDIO_PUBLIC_ORIGIN=http://127.0.0.1:8093
STUDIO_LOGIN_USERNAME=operator
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_PUBLISHED_PORT=8093
# Required secret files under AUTOMATION_SECRETS_DIR:
# db_runtime_password, db_migrator_password, admin_bootstrap_token,
# jira_webhook_secret, jira_api_token, bitbucket_api_token.
# GUI additionally uses gui_api_token (delegated) and studio_login_password.
