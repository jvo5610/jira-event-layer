# Local only. Copy to .env.studio and pass --env-file .env.studio.
STUDIO_PORT=8091
# Explicit destinations; no wildcard allowlists. Set yours before saving rules.
STUDIO_JIRA_PROJECTS=
STUDIO_REPOSITORIES=
STUDIO_JIRA_FIELDS=summary,description,labels,priority,assignee,duedate
STUDIO_JIRA_REQUIRED_LABEL=automation-managed
# Optional real connectors. Empty by default; no fake provider or credentials.
STUDIO_JIRA_ACCOUNT_EMAIL=
STUDIO_JIRA_API_TOKEN=
STUDIO_JIRA_CLOUD_ID=
STUDIO_BITBUCKET_ACCOUNT_EMAIL=
STUDIO_BITBUCKET_API_TOKEN=
