# Runtime configuration, not build arguments. Do not commit real secrets.
# Backend address as seen by the console process/container; no credentials in URLs.
STUDIO_BACKEND_URL=http://api:8080
# Browser origin; HTTPS is mandatory for non-loopback shared access.
STUDIO_PUBLIC_ORIGIN=http://127.0.0.1:8093
STUDIO_LOGIN_USERNAME=operator
# Existing files supplied by the operator. Login password: at least 16 characters.
STUDIO_BACKEND_TOKEN_FILE=./secrets/admin_token
STUDIO_LOGIN_PASSWORD_FILE=./secrets/studio_login_password
# Compose host publication only; the container listens on 8080.
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_PUBLISHED_PORT=8093
