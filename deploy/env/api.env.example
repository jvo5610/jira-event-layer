# API única: gestión y webhook. Inyectar con la plataforma; Python no lee este archivo.
TENANT_ID=mi-empresa
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=jira_relay
DB_USER=jira_relay_runtime
DB_PASSWORD_FILE=/run/secrets/db_runtime_password
JIRA_WEBHOOK_SECRET_FILE=/run/secrets/jira_webhook_secret
# Sólo para inicializar el primer administrador; luego puede retirarse.
ADMIN_BOOTSTRAP_TOKEN_FILE=/run/secrets/admin_bootstrap_token
AUTH_ROTATION_TTL_SECONDS=3600
MAX_BODY_BYTES=10485760
# Si hay acciones Bitbucket, usar la misma lista que en worker.
ALLOWED_REPOSITORIES=
# Opcional: catálogo de conectores. No hace falta para recibir webhooks Jira.
# JIRA_CLOUD_ID=<uuid-del-sitio>
# JIRA_API_TOKEN_FILE=/run/secrets/jira_api_token
# BITBUCKET_ACCOUNT_EMAIL=<email>
# BITBUCKET_API_TOKEN_FILE=/run/secrets/bitbucket_api_token
