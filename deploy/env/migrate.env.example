# Trabajo previo: python -m app.migrate. Nunca usar este rol en API/worker.
# Retención recibe las mismas variables pero con rol/contraseña runtime.
TENANT_ID=mi-empresa
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=jira_relay
DB_USER=jira_relay_migrator
DB_PASSWORD_FILE=/run/secrets/db_migrator_password
