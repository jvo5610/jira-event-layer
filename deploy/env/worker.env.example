# Ejecuta acciones. No recibe bootstrap, secreto HMAC ni configuración Studio.
TENANT_ID=mi-empresa
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=jira_relay
DB_USER=jira_relay_runtime
DB_PASSWORD_FILE=/run/secrets/db_runtime_password
# Habilitar Jira OAuth 2LO: definir los tres valores; incluir scope read:jira-user.
# JIRA_CLOUD_ID=<uuid-del-sitio>
# JIRA_CLIENT_ID=<client-id-de-la-cuenta-de-servicio>
# JIRA_CLIENT_SECRET_FILE=/run/secrets/jira_client_secret
JIRA_MAX_DAILY_WRITES=100
# Habilitar Bitbucket: credenciales con permisos sobre los destinos de las reglas.
# BITBUCKET_API_TOKEN_FILE=/run/secrets/bitbucket_api_token
BITBUCKET_MAX_DAILY_WRITES=100
# WORKER_ID=<identidad-unica-si-el-hostname-no-es-unico>
