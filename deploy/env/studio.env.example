# Gateway de jira-relay-studio, no recibe DB, tenant ni tokens de proveedor.
STUDIO_BACKEND_URL=https://api.example.internal
STUDIO_PUBLIC_ORIGIN=https://relay.example.com
STUDIO_BACKEND_TOKEN_FILE=/run/secrets/gui_api_token
STUDIO_AUTH_MODE=basic
STUDIO_LOGIN_USERNAME=operator
STUDIO_LOGIN_PASSWORD_FILE=/run/secrets/studio_login_password
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8080
# STUDIO_STATIC_DIR=/app/frontend/dist
