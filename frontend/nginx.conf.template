# Local-only gateway. Never publish this admin gateway on a public ingress.
map $http_origin $studio_origin_ok {
  default 0;
  "" 1;
  "http://localhost:${STUDIO_PORT}" 1;
  "http://127.0.0.1:${STUDIO_PORT}" 1;
}
map $http_host $studio_host_ok {
  default 0;
  "localhost:${STUDIO_PORT}" 1;
  "127.0.0.1:${STUDIO_PORT}" 1;
}
map $uri $studio_cache {
  default "no-store";
  ~^/assets/ "public, max-age=31536000, immutable";
}
server {
  listen 80;
  server_name localhost;
  root /usr/share/nginx/html;
  client_max_body_size 1m;
  gzip on;
  gzip_types application/javascript text/css application/json image/svg+xml;
  gzip_min_length 512;
  add_header Cache-Control $studio_cache always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
  location = /healthz { access_log off; return 200 'ok'; }
  location /api/ {
    if ($studio_origin_ok = 0) { return 403; }
    if ($studio_host_ok = 0) { return 403; }
    proxy_pass http://api:8080/;
    proxy_set_header Authorization "Bearer ${STUDIO_ADMIN_TOKEN}";
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_read_timeout 30s;
  }
  location /assets/ { try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}
